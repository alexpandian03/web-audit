# Port for Express API server (provided dynamically by Render in production, defaults to 5000 locally)
PORT=10000

# Application environment mode (development or production)
NODE_ENV=production

# MongoDB Atlas connection URI (required on startup)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/website-audit?retryWrites=true&w=majority

# Active search provider to discover websites (serpapi or places)
SEARCH_PROVIDER=serpapi

# SerpApi API key for Google searches (required when SEARCH_PROVIDER=serpapi)
SERPAPI_KEY=your_serpapi_api_key_here

# Google Places API key (required when SEARCH_PROVIDER=places)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Comma-separated allowed frontend origins for CORS (e.g. your Vercel URL, no trailing slashes)
CLIENT_ORIGIN=https://your-sitecheck-client.vercel.app

# Optional secret access key to protect search API quota (if set, clients must pass x-access-key)
APP_ACCESS_KEY=your_secret_access_key_here

# Allow crawling private RFC1918 IPs (only for local tests; forced to false in production)
ALLOW_PRIVATE=false

CLIENT_ORIGIN=